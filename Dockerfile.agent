FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-server ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/run/sshd

# Create test user with password auth
RUN useradd -m holeuser && echo "holeuser:holepass" | chpasswd && \
    sed -ri 's/^#?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -ri 's/^#?PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config

# Copy prebuilt Linux binary
COPY dist/hole-linux-x64 /usr/local/bin/hole
RUN chmod +x /usr/local/bin/hole

# Expose SSH (used only inside container)
EXPOSE 22

CMD service ssh start && hole up --name docker-host
