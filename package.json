{
  "name": "hole",
  "version": "0.3.5",
  "description": "P2P SSH tunnel via HyperDHT — no port forwarding, no VPN",
  "type": "module",
  "main": "hole.js",
  "bin": {
    "hole": "./hole.js"
  },
  "scripts": {
    "start": "node hole.js",
    "agent": "node hole.js agent",
    "client": "node hole.js client",
    "relay": "node hole.js relay",
    "build": "node scripts/build.js"
  },
  "pkg": {
