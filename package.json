{
  "name": "hole",
  "version": "0.4.1",
  "description": "P2P service access via HyperDHT — no port forwarding, no VPN",
  "type": "module",
  "main": "hole.js",
  "bin": {
    "hole": "./hole.js"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-pkg-into-stream.js",
    "start": "node hole.js",
    "up": "node hole.js up",
    "tunnel": "node hole.js tunnel",
    "agent": "node hole.js agent",
    "client": "node hole.js client",
    "relay": "node hole.js relay",
    "test:unit": "node --test test/unit/*.test.js",
    "test:cli": "node --test test/cli/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test": "npm run test:unit && npm run test:cli && npm run test:e2e",
    "build": "node scripts/build.js"
  },
  "pkg": {
    "assets": [
      "node_modules/sodium-native/prebuilds/**/*.node",
      "node_modules/udx-native/prebuilds/**/*.node",
      "node_modules/node-pty/build/Release/*.node",
      "node_modules/node-pty/prebuilds/**/*.node"
    ]
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "b4a": "^1.8.0",
    "hyperdht": "^6.29.1",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.18.2",
    "esbuild": "^0.27.3",
    "into-stream": "6.0.0",
    "ssh2": "^1.17.0"
  },
  "overrides": {
    "@yao-pkg/pkg": {
      "into-stream": "6.0.0"
    }
  }
}
